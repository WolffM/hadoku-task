{
  "name": "@wolffm/task-ui-components",
  "version": "1.2.4",
  "description": "Reusable UI components for task management applications",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./theme-picker.css": "./dist/theme-picker.css",
    "./toaster.css": "./dist/toaster.css",
    "./context-menu.css": "./dist/context-menu.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly && node scripts/fix-imports.cjs && pnpm run copy-css",
    "copy-css": "node -e \"const fs=require('fs'); fs.copyFileSync('dist/task-ui-components.css', 'dist/styles.css'); fs.copyFileSync('src/theme-picker.css', 'dist/theme-picker.css'); fs.copyFileSync('src/toaster.css', 'dist/toaster.css'); fs.copyFileSync('src/context-menu.css', 'dist/context-menu.css')\"",
    "version:smart": "node scripts/version-manager.cjs",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "theme-picker",
    "ui-components",
    "react",
    "themes",
    "task-management"
  ],
  "author": "wolffm",
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.0.0",
    "vite": "^7.1.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/WolffM/hadoku-task.git",
    "directory": "task-ui-components"
  }
}
