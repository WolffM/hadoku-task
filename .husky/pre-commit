#!/bin/sh
# NOTE: husky's wrapper invokes hooks with `sh -e`, ignoring the script's
# shebang. All conditionals must be POSIX-compatible (use `[ ]`, not `[[ ]]`)
# or they silently noop on Debian-likes where /bin/sh is dash.
#
# Quality gates only. No commit carries a version number: publish.yml sets
# each package's version at publish time (hadoku-actions/next-version, one
# patch above the registry's newest) in the runner's workspace and never
# commits it back.
#
# CI / automated commits must NOT run these interactive dev gates: CI has its
# own (ci.yml runs typecheck, lint and lint:css explicitly). GitHub Actions
# always sets CI=true. Mirrors the guard hadoku_site added for the same failure.

# --- worktree preamble ---------------------------------------------------
# git resolves a relative core.hooksPath against the WORKING TREE ROOT, so a
# hook only fires in a linked worktree when the directory holding it is tracked.
# husky's generated .husky/_ is not — its own .gitignore excludes it — so every
# commit made from a worktree ran no hook at all. Silently: no warning, no
# non-zero exit. core.hooksPath now points at .husky itself, which is tracked.
[ "${HUSKY-}" = "0" ] && exit 0

# A fresh worktree is missing everything .gitignore excludes, node_modules
# included. Install this worktree's OWN (pnpm hardlinks from its store, so it
# takes seconds when the store is warm). Never link the main checkout's: through
# those links the workspace packages resolve to the MAIN checkout's source, so a
# branch that changes one is typechecked against the old code, and a
# `pnpm install` run in the worktree writes through them into the main checkout.
# Links an older copy of this preamble left behind are removed first.
common_dir=$(git rev-parse --git-common-dir)
case "$common_dir" in /*) ;; *) common_dir="$PWD/$common_dir" ;; esac
main_checkout=$(dirname "$common_dir")

if [ "$main_checkout" != "$PWD" ]; then
  for nm in $(find . -maxdepth 4 \( -path ./.claude -o -name node_modules -type d \) -prune -o -name node_modules -type l -print); do
    case "$(readlink "$nm")" in
      "$main_checkout"/*) echo "🧹 Removing $nm, a link into the main checkout"; rm "$nm" ;;
    esac
  done
fi
if [ ! -e node_modules ]; then
  echo "📦 No node_modules — installing this checkout's own"
  if ! CI=true pnpm install --frozen-lockfile; then
    echo "❌ pnpm install failed. A private @wolffm package needs NODE_AUTH_TOKEN; install, then commit again."
    exit 1
  fi
fi
# The typecheck reads themes and task-ui-components through their built dist/
# (package.json "types"), and a fresh checkout has neither. Build them from THIS
# checkout's source, so a change to either is what gets checked.
if [ ! -d themes/dist ] || [ ! -d task-ui-components/dist ]; then
  echo "🏗️  No themes/ or task-ui-components/ dist — building the workspace packages"
  if ! pnpm run build:packages; then
    echo "❌ build:packages failed — fix it before committing."
    exit 1
  fi
fi
# --- end worktree preamble -----------------------------------------------

[ "$CI" = "true" ] && exit 0

echo "🔍 Running pre-commit checks..."

# TS gate — prevents commits that break tsc (resilience plan track 1).
# tsBuildInfoFile makes this an incremental check on warm caches (~1-3s
# instead of ~25s) so leave it as a hard gate.
echo "🔎 Running typecheck..."
if ! pnpm run typecheck; then
  echo "❌ TypeScript errors — fix before committing (or --no-verify to bypass)."
  exit 1
fi

# Lint + format ONLY the staged files via lint-staged. This replaces the
# previous "lint everything + format everything" approach which was
# (a) slow on every commit regardless of scope and (b) auto-staged
# unrelated worktree changes via `git add -u`, breaking parallel work.
#
# --no-stash: lint-staged's default backs up the index and working tree in a
# `git stash` entry. refs/stash lives in the COMMON git dir, so every worktree
# shares one stack, and parallel agents committing at once push and pop each
# other's entries. AGENTS.md forbids git stash in this repo for that reason.
#
# --no-stash also turns off hiding unstaged hunks, so a fixer's re-add would
# sweep a partially staged file's UNSTAGED changes into the commit. Refuse that
# case up front instead.
staged_list=$(mktemp)
git diff --cached --name-only --diff-filter=ACMR > "$staged_list"
partial=$(git diff --name-only | grep -Fx -f "$staged_list" || true)
rm -f "$staged_list"
if [ -n "$partial" ]; then
  echo "❌ These files have both staged and unstaged changes:"
  echo "$partial" | sed 's/^/     /'
  echo "   The formatters would fold the unstaged part into this commit. Stage the"
  echo "   whole file, or set the rest aside in a WIP commit (never git stash)."
  exit 1
fi
echo "📋 Running lint-staged on staged files..."
if ! pnpm exec lint-staged --no-stash; then
  echo "❌ Lint or format failed on staged files."
  exit 1
fi
echo "✅ Linting and formatting complete!"

# CSS + theme-token gate. Always runs over the full file set, not just staged
# files, because var refs depend on defs in other (possibly unstaged) files.
#   stylelint          — unknown custom properties in .css
#   check-contrast     — token symmetry + every WCAG pair in every theme
#   check-tailwind     — tailwind-colors.css still matches style.css
#   check-docs         — THEME_USAGE_GUIDE.md still lists exactly the real tokens
#   check-usage        — unknown tokens, unmapped Tailwind classes in .tsx,
#                        banned var() fallbacks, layered style.css imports
# The last three cover blind spots stylelint has by design: it never reads
# .tsx, and it deliberately ignores `var(--typo, #fallback)`.
echo "🎨 Running stylelint + theme token validation..."
if ! pnpm run lint:css; then
  echo "❌ CSS/theme gate failed — check the var name or class against @wolffm/themes."
  exit 1
fi

echo "✅ All pre-commit checks passed!"
