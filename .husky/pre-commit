#!/bin/sh
# NOTE: husky's wrapper invokes hooks with `sh -e`, ignoring the script's
# shebang. All conditionals must be POSIX-compatible (use `[ ]`, not `[[ ]]`)
# or they silently noop on Debian-likes where /bin/sh is dash.
#
# Quality gates, then a version bump for whatever publishable package this
# commit actually touches (scripts/version-bump.mjs).
#
# The bump is here so a push to main ALREADY carries a publishable version and
# publish.yml never writes a follow-up "auto-bump" commit on main. CI keeps its
# registry-aware bump as a backstop for what a local hook can't cover: bot
# commits, --no-verify, and a version that turns out to be taken.
#
# The two objections that got bumping removed from here once are both handled:
# dev-only edits (docs/, e2e/, scripts/, plugins/) don't match any package, so
# they burn no version; and the lockfile records workspace deps as `link:`, so
# a bump never touches it.
#
# CI / automated commits must NOT run these interactive dev gates. publish.yml's
# auto-bump step does a `git commit`, which fires this hook inside the runner —
# where typecheck needs an install that hasn't happened yet, so the bump fails
# and the publish dies with "TypeScript errors" that don't exist in the tree.
# CI has its own gates (this same workflow runs typecheck and lint:css
# explicitly). GitHub Actions always sets CI=true.
# Mirrors the guard hadoku_site added for the same failure.

# --- worktree preamble ---------------------------------------------------
# git resolves a relative core.hooksPath against the WORKING TREE ROOT, so a
# hook only fires in a linked worktree when the directory holding it is tracked.
# husky's generated .husky/_ is not — its own .gitignore excludes it — so every
# commit made from a worktree ran no hook at all. Silently: no warning, no
# non-zero exit. core.hooksPath now points at .husky itself, which is tracked.
[ "${HUSKY-}" = "0" ] && exit 0

# Firing the hook is only half of it. A fresh worktree is missing everything
# .gitignore excludes, and the gates below read some of it. Borrow those from
# the main checkout rather than skipping the gate: same repo, and in the normal
# case the same artifacts. A branch that genuinely CHANGES dependencies fails
# loudly on the missing package instead, which is the outcome we want.
common_dir=$(git rev-parse --git-common-dir)
case "$common_dir" in /*) ;; *) common_dir="$PWD/$common_dir" ;; esac
main_checkout=$(dirname "$common_dir")

if [ ! -e node_modules ]; then
  if [ "$main_checkout" != "$PWD" ] && [ -d "$main_checkout/node_modules" ]; then
    echo "🔗 No node_modules in this worktree — linking the main checkout's"
    # pnpm lays node_modules out as a symlink farm over its own .pnpm store, so
    # pointing at it works. A workspace keeps one PER PACKAGE, and a gate that
    # shells into one (themes/, worker/, frontend/) fails on a missing
    # devDependency if only the root is linked — so link every one it has.
    for nm in $(cd "$main_checkout" && find . -maxdepth 4 -name node_modules -prune | sed 's|^\./||'); do
      [ -e "$nm" ] && continue
      [ -d "$(dirname "$nm")" ] || continue
      ln -s "$main_checkout/$nm" "$nm"
    done
  else
    echo "❌ No node_modules — run 'pnpm install' before committing."
    exit 1
  fi
fi
# --- end worktree preamble -----------------------------------------------

[ "$CI" = "true" ] && exit 0

echo "🔍 Running pre-commit checks..."

# TS gate — prevents commits that break tsc (resilience plan track 1).
# tsBuildInfoFile makes this an incremental check on warm caches (~1-3s
# instead of ~25s) so leave it as a hard gate.
echo "🔎 Running typecheck..."
if ! pnpm run typecheck; then
  echo "❌ TypeScript errors — fix before committing (or --no-verify to bypass)."
  exit 1
fi

# Lint + format ONLY the staged files via lint-staged. This replaces the
# previous "lint everything + format everything" approach which was
# (a) slow on every commit regardless of scope and (b) auto-staged
# unrelated worktree changes via `git add -u`, breaking parallel work.
echo "📋 Running lint-staged on staged files..."
if ! pnpm exec lint-staged; then
  echo "❌ Lint or format failed on staged files."
  exit 1
fi
echo "✅ Linting and formatting complete!"

# CSS + theme-token gate. Always runs over the full file set, not just staged
# files, because var refs depend on defs in other (possibly unstaged) files.
#   stylelint          — unknown custom properties in .css
#   check-contrast     — token symmetry + every WCAG pair in all 18 themes
#   check-tailwind     — tailwind-colors.css still matches style.css
#   check-docs         — THEME_USAGE_GUIDE.md still lists exactly the real tokens
#   check-usage        — unknown tokens, unmapped Tailwind classes in .tsx,
#                        banned var() fallbacks, layered style.css imports
# The last three cover blind spots stylelint has by design: it never reads
# .tsx, and it deliberately ignores `var(--typo, #fallback)`.
echo "🎨 Running stylelint + theme token validation..."
if ! pnpm run lint:css; then
  echo "❌ CSS/theme gate failed — check the var name or class against @wolffm/themes."
  exit 1
fi

# Version bump LAST, once the gates have passed — a commit that's about to be
# rejected must not leave a bumped package.json behind. Bumps only the packages
# whose files are staged (plus their dependents) and re-stages the package.json.
echo "🔢 Bumping versions for changed packages..."
if ! node scripts/version-bump.mjs; then
  echo "❌ Version bump failed."
  exit 1
fi

echo "✅ All pre-commit checks passed!"
