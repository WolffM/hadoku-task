{
  "name": "@wolffm/task",
  "version": "3.2.1",
  "description": "API definitions and business logic for the Task application.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolffM/hadoku-task.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist",
    "docs/API.md",
    "docs/CHANGELOG.md",
    "README.md"
  ],
  "exports": {
    "./api": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./frontend": "./dist/index.js",
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build:all": "npm run build && npm run build:server",
    "preview": "vite preview",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:smart": "node scripts/version-manager.js",
    "trim-changelog": "node scripts/trim-changelog.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@wolffm/themes": "^1.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "husky": "^9.1.7",
    "typescript": "^5.6.3",
    "vite": "^7.1.12"
  }
}
