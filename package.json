{
  "name": "@wolffm/task",
  "version": "3.0.6",
  "description": "API definitions and business logic for the Task application.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolffM/hadoku-task.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist",
    "API.md",
    "README.md",
    "docs/PARENT_API_REFERENCE.md",
    "docs/refator/PARENT_API_COMPLIANCE.md"
  ],
  "exports": {
    "./api": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./frontend": "./dist/index.js",
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build:all": "npm run build && npm run build:server",
    "preview": "vite preview",
    "test:server": "tsx test-server.ts",
    "version:patch": "npm version patch --no-git-tag-version",
    "prepare": "husky"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "husky": "^9.1.7",
    "tsx": "^4.7.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.0"
  }
}
