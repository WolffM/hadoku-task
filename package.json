{
  "name": "@wolffm/task",
  "version": "3.4.95",
  "description": "Minimalist, portable task manager - embeddable micro-frontend with framework-agnostic API handlers",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolffM/hadoku-task.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist",
    "docs/API.md",
    "docs/CHANGELOG.md",
    "README.md"
  ],
  "exports": {
    "./api": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./worker": "./dist/worker/index.js",
    "./frontend": {
      "types": "./dist/app/entry.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "pnpm run build:packages && node ../hadoku_site/scripts/secrets/dev-vault.mjs -- vite",
    "build": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build:worker": "tsup --config tsup.worker.config.ts",
    "build:packages": "pnpm --filter @wolffm/task-ui-components run build && pnpm --filter @wolffm/themes run build",
    "build:all": "pnpm run build:packages && pnpm run build && pnpm run build:server && pnpm run build:worker",
    "preview": "vite preview",
    "typecheck": "pnpm --filter @wolffm/task-ui-components --filter @wolffm/themes --parallel run typecheck && tsc --noEmit",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --cache --fix",
    "lint:css": "stylelint \"src/**/*.css\" && pnpm --filter @wolffm/themes run validate",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\" --cache",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\" --cache",
    "version:patch": "pnpm version patch --no-git-tag-version",
    "trim-changelog": "node scripts/trim-changelog.js",
    "prepare": "husky",
    "test:e2e": "pw-isolated playwright test",
    "test:e2e:ui": "pw-isolated playwright test --ui",
    "test:e2e:debug": "pw-isolated playwright test --debug",
    "profile": "node scripts/profile-cold-load.mjs"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.4.0",
    "@wolffm/logger": "^1.3.1",
    "@wolffm/prefs-client": "^1.0.5",
    "@wolffm/task-ui-components": "workspace:*",
    "@wolffm/themes": "workspace:*",
    "@wolffm/worker-utils": "^1.2.13",
    "hono": "^4.12.23",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260604.1",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.60.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitejs/plugin-react": "^5.1.1",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.6.2",
    "stylelint": "^17.12.0",
    "stylelint-value-no-unknown-custom-properties": "^6.1.1",
    "tsup": "^8.4.0",
    "typescript": "^5.6.3",
    "vite": "^7.2.4"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --cache --fix",
      "prettier --write --cache"
    ],
    "*.{json,css,md}": [
      "prettier --write --cache"
    ]
  },
  "packageManager": "pnpm@11.5.0+sha512.dbfcc4f81cf48597afd4bc391ffdf12c11f1a9fb83a395bfa6b0a2d9cc2fd8ffebafdb1ccbd529632153f793904c2615b7f09fe1a345473fd1c35845172a8eb1"
}
