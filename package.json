{
  "name": "@wolffm/task",
  "version": "3.4.38",
  "description": "Minimalist, portable task manager - embeddable micro-frontend with framework-agnostic API handlers",
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolffM/hadoku-task.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist",
    "docs/API.md",
    "docs/CHANGELOG.md",
    "README.md"
  ],
  "exports": {
    "./api": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./frontend": {
      "types": "./dist/app/entry.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "pnpm run build:packages && vite",
    "build": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build:packages": "pnpm --filter @wolffm/task-ui-components run build && pnpm --filter @wolffm/themes run build",
    "build:all": "pnpm run build:packages && pnpm run build && pnpm run build:server",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "version:patch": "pnpm version patch --no-git-tag-version",
    "trim-changelog": "node scripts/trim-changelog.js",
    "prepare": "husky",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug"
  },
  "dependencies": {
    "@wolffm/task-ui-components": "workspace:*",
    "@wolffm/themes": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.57.0",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "typescript": "^5.6.3",
    "vite": "^7.2.4"
  },
  "pnpm": {
    "overrides": {
      "js-yaml": "4.1.1"
    }
  }
}
