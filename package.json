{
  "name": "@wolffm/task",
  "version": "3.3.3",
  "description": "API definitions and business logic for the Task application.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolffM/hadoku-task.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist",
    "docs/API.md",
    "docs/CHANGELOG.md",
    "README.md"
  ],
  "exports": {
    "./api": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./frontend": "./dist/index.js",
    "./style.css": "./dist/task.css"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "pnpm run build:packages && vite",
    "build": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build:packages": "pnpm --filter @wolffm/task-ui-components run build && pnpm --filter @wolffm/themes run build",
    "build:all": "pnpm run build:packages && pnpm run build && pnpm run build:server",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "version:patch": "pnpm version patch --no-git-tag-version",
    "version:smart": "node scripts/version-manager.js",
    "trim-changelog": "node scripts/trim-changelog.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@wolffm/task-ui-components": "workspace:*",
    "@wolffm/themes": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "typescript": "^5.6.3",
    "vite": "^7.1.12"
  }
}
