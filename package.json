{
  "name": "@wolffm/task",
  "version": "3.4.59",
  "description": "Minimalist, portable task manager - embeddable micro-frontend with framework-agnostic API handlers",
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolffM/hadoku-task.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist",
    "docs/API.md",
    "docs/CHANGELOG.md",
    "README.md"
  ],
  "exports": {
    "./api": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./worker": "./dist/worker/index.js",
    "./frontend": {
      "types": "./dist/app/entry.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "pnpm run build:packages && node ../hadoku_site/scripts/secrets/dev-vault.mjs -- vite",
    "build": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build:worker": "tsup --config tsup.worker.config.ts",
    "build:packages": "pnpm --filter @wolffm/task-ui-components run build && pnpm --filter @wolffm/themes run build",
    "build:all": "pnpm run build:packages && pnpm run build && pnpm run build:server && pnpm run build:worker",
    "preview": "vite preview",
    "typecheck": "pnpm --filter @wolffm/task-ui-components --filter @wolffm/themes --parallel run typecheck && tsc --noEmit",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --cache --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\" --cache",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\" --cache",
    "version:patch": "pnpm version patch --no-git-tag-version",
    "trim-changelog": "node scripts/trim-changelog.js",
    "prepare": "husky",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.1.5",
    "@wolffm/prefs-client": "^1.0.1",
    "@wolffm/task-ui-components": "workspace:*",
    "@wolffm/themes": "workspace:*",
    "@wolffm/worker-utils": "^1.0.0",
    "hono": "^4.11.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251230.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.57.0",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "@vitejs/plugin-react": "^5.1.1",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.6.2",
    "tsup": "^8.4.0",
    "typescript": "^5.6.3",
    "vite": "^7.2.4"
  },
  "pnpm": {
    "overrides": {
      "js-yaml": "4.1.1"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --cache --fix",
      "prettier --write --cache"
    ],
    "*.{json,css,md}": [
      "prettier --write --cache"
    ]
  }
}
