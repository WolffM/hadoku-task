{
  "name": "@wolffm/themes",
  "version": "5.14.0",
  "description": "16 themes with a symmetric, WCAG-verified token set and a complete Tailwind v4 color mapping - Light, Dark, Ocean, Cyberpunk, Coffee, Lavender, Nature, Pink, Izakaya",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolffM/hadoku-task.git",
    "directory": "themes"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist",
    "src/style.css",
    "src/advanced.css",
    "src/tailwind-integration.css",
    "src/tailwind-colors.css",
    "src/icons.css",
    "src/icons",
    "src/theme-bootstrap.js",
    "scripts",
    "README.md",
    "THEME_USAGE_GUIDE.md",
    "LICENSE-lucide"
  ],
  "exports": {
    "./style.css": "./src/style.css",
    "./advanced.css": "./src/advanced.css",
    "./tailwind-integration.css": "./src/tailwind-integration.css",
    "./tailwind-colors.css": "./src/tailwind-colors.css",
    "./icons.css": "./src/icons.css",
    "./theme-bootstrap.js": "./src/theme-bootstrap.js",
    "./THEME_USAGE_GUIDE.md": "./THEME_USAGE_GUIDE.md",
    "./check-usage": "./scripts/check-usage.mjs",
    "./contract": {
      "types": "./scripts/lib/contract.d.mts",
      "default": "./scripts/lib/contract.mjs"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "default": "./dist/icons/index.js"
    },
    "./icons/react": {
      "types": "./dist/icons/Icon.d.ts",
      "default": "./dist/icons/Icon.js"
    },
    "./platform": {
      "types": "./dist/platform/index.d.ts",
      "default": "./dist/platform/index.js"
    },
    "./platform/react": {
      "types": "./dist/platform/usePlatform.d.ts",
      "default": "./dist/platform/usePlatform.js"
    },
    "./theme-bootstrap": {
      "types": "./dist/theme-bootstrap.d.ts",
      "default": "./dist/theme-bootstrap.js"
    },
    "./check-icons": "./scripts/check-icons.mjs"
  },
  "scripts": {
    "build": "tsc && node ../scripts/fix-imports.cjs dist && node scripts/build-theme-bootstrap.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/*.test.mjs'",
    "prepublishOnly": "pnpm run build",
    "audit:tokens": "node scripts/audit-tokens.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:usage": "node scripts/check-usage.mjs ..",
    "check:tailwind": "node scripts/generate-tailwind-colors.mjs --check",
    "check:docs": "node scripts/check-docs.mjs",
    "generate:tailwind": "node scripts/generate-tailwind-colors.mjs",
    "generate:preview": "node scripts/generate-preview.mjs",
    "normalize:tokens": "node scripts/normalize-tokens.mjs",
    "validate": "pnpm run check:contrast && pnpm run check:tailwind && pnpm run check:docs && pnpm run check:icons && pnpm run check:usage && pnpm run test",
    "generate:icons": "node scripts/generate-icons.mjs",
    "check:icons": "node scripts/generate-icons.mjs --check && node scripts/check-icons.mjs .."
  },
  "keywords": [
    "themes",
    "css-variables",
    "design-tokens",
    "dark-mode",
    "color-schemes",
    "tailwind-v4",
    "hadoku"
  ],
  "author": "WolffM",
  "license": "MIT",
  "dependencies": {
    "@wolffm/prefs-client": "^1.1.26",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.16",
    "lucide-static": "1.28.0",
    "typescript": "^5.6.3"
  },
  "bin": {
    "hadoku-check-icons": "./scripts/check-icons.mjs",
    "hadoku-codemod-icons": "./scripts/codemod-icons.mjs"
  }
}
