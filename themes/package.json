{
  "name": "@wolffm/themes",
  "version": "1.1.16",
  "description": "16 beautiful themes (8 base themes with light/dark variants) using CSS custom properties - Light, Dark, Strawberry, Ocean, Cyberpunk, Coffee, Lavender, Nature, Pink",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolffM/hadoku-task.git",
    "directory": "themes"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist",
    "src/style.css",
    "README.md"
  ],
  "exports": {
    "./style.css": "./src/style.css",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc && node scripts/fix-imports.cjs",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "themes",
    "css-variables",
    "design-tokens",
    "dark-mode",
    "color-schemes",
    "hadoku"
  ],
  "author": "WolffM",
  "license": "MIT",
  "peerDependencies": {
    "@wolffm/task-ui-components": "*",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@wolffm/task-ui-components": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.6",
    "@wolffm/task-ui-components": "workspace:*",
    "typescript": "^5.6.3"
  }
}
