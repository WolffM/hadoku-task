# Node modules
node_modules
themes/node_modules/
dist/
dist-ssr/

# Build files
*.local
*.log*

# Local dev log sink (src/utils/devLogSink.ts → vite /__devlog)
.dev-logs/

# TypeScript compilation artifacts (auto-generated)
src/**/*.js
src/**/*.d.ts
src/**/*.js.map
src/**/*.d.ts.map

# IMPORTANT: Exceptions for manually-maintained files that MUST be committed
# These files are required by the build process and are validated in CI
!src/app/entry.d.ts          # Type definitions for package exports (used by vite.config.ts)

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment files
.env
.env.local
.env.*.local
.env*.bak*
.env.*~*

# Backup files
*.old.*
*.backup.*
.husky/*.backup

# Scratch / temp files — the debugging screenshot or throwaway note that gets
# dropped at the repo root and then lives there for weeks (a temp.png sat here
# from 2026-07-21 to 2026-08-08 purely because nothing ignored it).
#
# Matched on NAME, never on extension. `*.png` would be the obvious rule and it
# would be wrong: calendar-mockups/*.png are committed assets, so that rule
# would quietly hide the next real mockup someone adds.
temp.*
tmp.*
*.tmp
temp/
tmp/
scratch.*
scratch/

# Note: task/data is intentionally committed for personal backup/sync
package-lock.json

# Development-only tools
themes/dev/save-server.js

# Playwright test outputs
playwright-report/
test-results/
.playwright-mcp/

# Tooling caches (under node_modules/.cache/* but list explicitly for clarity)
.eslintcache
.prettiercache
*.tsbuildinfo

# per-repo vault key (Phase 2 of per-key ACL plan; never commit)
.devvault.local.json

# Cold-load profiler run logs (scripts/profile-cold-load.mjs)
.profiler/

# vibeCheck audit working artifacts (regenerable; ledger + trends stay tracked)
.vibecompact/audit.md
.vibecompact/out/

# Agent worktrees (`git worktree add .claude/worktrees/<task>`). A worktree is
# a FULL second checkout, so without this a `git add -A` commits one whole.
# Scoped deliberately: the REST of .claude/ is tracked (1 file is here), and a
# blanket `.claude/` would silently swallow the next file added to it.
.claude/worktrees/

# Per-machine agent permissions. Machine-local by name and by nature — 44 of the
# 50 repos here already ignore it; the handful that tracked it reported
# "uncommitted changes" on every nightly repo sync, forever.
.claude/settings.local.json
